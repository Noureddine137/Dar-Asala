generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LeatherColor {
  COGNAC
  DARK_BROWN
  BLACK
  OLIVE
  NATURAL
}

enum BagSize {
  MINI
  MEDIUM
  LARGE
}

enum HardwareFinish {
  BRASS
  ANTIQUE_BRASS
}

enum StrapType {
  STANDARD
  LONG
  ADJUSTABLE
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  description      String
  story            String?
  price            Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)
  currency         String        @default("EUR")
  status           ProductStatus @default(ACTIVE)
  featured         Boolean       @default(false)
  isNew            Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  isMadeToOrder    Boolean       @default(false)
  materials        String
  careInstructions String
  productionTime   String
  category         String

  images     ProductImage[]
  variants   ProductVariant[]
  collections CollectionProduct[]
  reviews    Review[]
  orderItems OrderItem[]
  wishlisted Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured])
  @@index([category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
  kind      String  @default("gallery") // gallery | hover | lifestyle | detail

  variants ProductVariant[]

  @@index([productId])
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String          @unique
  color         LeatherColor
  size          BagSize
  hardware      HardwareFinish  @default(BRASS)
  strap         StrapType       @default(STANDARD)
  priceOverride Decimal?        @db.Decimal(10, 2)
  stock         Int             @default(0)
  isMadeToOrder Boolean         @default(false)
  imageId       String?
  image         ProductImage?   @relation(fields: [imageId], references: [id])

  orderItems OrderItem[]

  @@index([productId])
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  heroImage   String
  position    Int     @default(0)
  active      Boolean @default(true)

  products CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@unique([collectionId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Customers & orders
// ---------------------------------------------------------------------------

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  addresses Address[]
  orders    Order[]
  wishlist  Wishlist[]
  createdAt DateTime  @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  city       String
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)

  @@index([customerId])
}

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  email             String
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  shipping          Decimal     @db.Decimal(10, 2) @default(0)
  discount          Decimal     @db.Decimal(10, 2) @default(0)
  total             Decimal     @db.Decimal(10, 2)
  currency           String      @default("EUR")
  shippingAddress   Json?
  // Destination country Stripe actually collected (ISO alpha-2). Flat/queryable
  // alongside shippingAddress. selectedShippingCountry is what the customer
  // chose on our own site before Checkout (see /api/checkout); shippingCountryMismatch
  // is true when the two differ — flagged for manual review, never
  // auto-cancelled/refunded.
  shippingCountry   String?
  selectedShippingCountry String?
  shippingCountryMismatch Boolean @default(false)
  trackingNumber    String?
  stripeSessionId   String?     @unique
  stripePaymentIntentId String? @unique

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  name      String
  variantLabel String?
  unitPrice Decimal         @db.Decimal(10, 2)
  quantity  Int
  imageUrl  String?

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Reviews, wishlist, newsletter, discounts, custom orders
// ---------------------------------------------------------------------------

model Review {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating            Int
  title             String
  content           String
  author            String
  country            String
  verifiedPurchase Boolean  @default(true)
  published         Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([productId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  consented Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  percentOff    Int?
  amountOff     Decimal?  @db.Decimal(10, 2)
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

model CustomOrderRequest {
  id                  String   @id @default(cuid())
  name                String
  email               String
  phone               String?
  requestedProductName String?
  leatherColor        String?
  dimensions          String?
  strapLength         String?
  initials            String?
  lining              String?
  hardware            String?
  message             String?
  status              String   @default("new")
  createdAt           DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Store settings, homepage CMS content, shipping zones, testimonials
// ---------------------------------------------------------------------------

model StoreSettings {
  id String @id @default("singleton")

  storeName             String  @default("Dar Asala")
  contactEmail          String  @default("hello@darasala.example")
  contactPhone          String?
  whatsappNumber        String?
  businessAddress       String?
  currency              String  @default("EUR")
  freeShippingThreshold Decimal @db.Decimal(10, 2) @default(250)
  defaultProductionTime String  @default("Made to order — handcrafted in 7-14 business days")
  instagramUrl          String?
  facebookUrl           String?
  tiktokUrl             String?

  brandOriginCountry     String @default("Morocco")
  brandWorkshopLocations String @default("Marrakech and Fez")
  leatherClaim            String @default("full-grain, vegetable-tanned leather")
  artisanProcessClaim     String @default("hand-cut, hand-stitched and finished by a single artisan from start to finish")
  productionModelClaim    String @default("small-batch, made to order")

  heroHeadline String @default("Handcrafted in Morocco. Made to last.")
  heroSubtitle String @default("Timeless leather bags shaped by our artisans, carried by you.")
  heroImageUrl String @default("/images/hero/hero-main.webp")
  heroCtaLabel String @default("Shop the Collection")
  heroCtaHref  String @default("/collections/all")

  brandStoryHeading  String @default("Slow by design.")
  brandStoryBody     String @default("Each Dar Asala piece is shaped by artisans using techniques rooted in Moroccan leather craftsmanship.")
  brandStoryImageUrl String @default("/images/brand/story.webp")

  customOrderHeading  String @default("Made for You")
  customOrderBody     String @default("Choose your leather, color, strap and selected finishing details, and our artisans will hand-build a piece around your choices.")
  customOrderImageUrl String @default("/images/brand/custom-orders.webp")

  newsletterHeading String @default("Letters from the Atelier")
  newsletterBody    String @default("New pieces, artisan stories and private releases — straight to your inbox, roughly once a month.")

  updatedAt DateTime @updatedAt
}

model ShippingZone {
  id            String   @id @default(cuid())
  region        String
  countries     String
  price         Decimal  @db.Decimal(10, 2) @default(0)
  freeThreshold Decimal? @db.Decimal(10, 2)
  estimate      String
  carrier       String?
  active        Boolean  @default(true)
  position      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id         String  @id @default(cuid())
  quote      String
  authorName String
  country    String
  rating     Int     @default(5)
  avatarUrl  String?
  position   Int     @default(0)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
}
