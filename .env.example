DATABASE_URL="postgresql://user:password@localhost:5432/darasala?schema=public"
NEXT_PUBLIC_SITE_URL="https://www.darasala.example"

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional integrations (leave blank to keep disabled)
RESEND_API_KEY=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Admin — required to access /admin. Sign in at /admin/login with these
# credentials; the session is a signed, httpOnly cookie (8h expiry), not raw
# Basic Auth. Set a dedicated ADMIN_SESSION_SECRET in production so rotating
# the password doesn't also invalidate every open session.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Custom-order box on the product page (digits only, country code, no "+")
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Product image uploads (Admin → Product → Images). Create a Blob store at
# https://vercel.com/dashboard/stores and copy its read/write token — works
# from any Next.js deployment, not just Vercel hosting. Without this set,
# admin image uploads are disabled with a clear message; pasting an image
# URL directly still works.
BLOB_READ_WRITE_TOKEN=""
