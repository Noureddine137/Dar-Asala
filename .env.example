# =============================================================================
# REQUIRED — the app will not function correctly in production without these.
# =============================================================================

# Neon production Postgres. Use the *pooled* connection string (hostname
# contains "-pooler", PgBouncer in transaction mode) — this is what every
# request/serverless function invocation uses.
DATABASE_URL="postgresql://user:password@localhost:5432/darasala?schema=public"

# The deployed site's canonical origin, no trailing slash — drives canonical
# URLs, OpenGraph/JSON-LD image URLs, sitemap.xml, robots.txt, and Stripe
# success/cancel URLs. Must be updated to the real Netlify custom domain
# before launch; a stale/incorrect value here silently breaks SEO tags and
# post-checkout redirects, not just cosmetics.
NEXT_PUBLIC_SITE_URL="https://www.darasala.example"

# Stripe — required for checkout to function at all. Test keys (sk_test_/
# pk_test_) until the Stripe production readiness checklist is complete and
# a human explicitly switches to live keys (sk_live_/pk_live_).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin — required to access /admin. Sign in at /admin/login with these
# credentials; the session is a signed, httpOnly cookie (8h expiry), not raw
# Basic Auth. There is no admin user database — these two env vars ARE the
# account. Use a long, random password (this is the only credential gating
# order/customer data and store configuration).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Signs and verifies the admin session cookie. Without this set, the app
# falls back to deriving the signing key from ADMIN_USERNAME:ADMIN_PASSWORD
# — functional, but it means rotating the password also invalidates every
# open session (and vice versa). Set a dedicated, random 32+ byte value in
# production (e.g. `openssl rand -base64 32`) so the two can rotate
# independently.
ADMIN_SESSION_SECRET=""

# =============================================================================
# OPTIONAL — safe to leave blank; each gates a specific feature off, with a
# clear fallback, rather than breaking the app.
# =============================================================================

# Neon's *unpooled* (direct) connection string, used only by
# `prisma migrate deploy` / `prisma migrate dev` — PgBouncer's transaction
# pooling mode doesn't support the session-level features migrations need.
# Leave blank locally (falls back to DATABASE_URL); set this in production
# alongside a pooled DATABASE_URL.
DIRECT_URL=""

# Not read anywhere in the current checkout flow — Stripe Checkout is used
# as a hosted redirect (session.url), which never needs the publishable key
# client-side. Kept here for if Stripe.js/Elements/Payment Element is added
# later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Product image uploads (Admin → Product → Images). Create a Blob store at
# https://vercel.com/dashboard/stores and copy its read/write token — works
# from any Next.js deployment, not just Vercel hosting (see production
# readiness notes on using Vercel Blob while hosted on Netlify). Without
# this set, admin image uploads are disabled with a clear message; pasting
# an image URL directly still works.
BLOB_READ_WRITE_TOKEN=""

# Contact-form emails. Without this set, submissions are accepted and
# logged server-side instead of emailed — the form still works, nothing is
# lost, but no email is sent.
RESEND_API_KEY=""

# Optional analytics — each script only loads if its ID is set.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# None of the variables above are gated to development-only use in code —
# the same names are read in both environments, only the values differ
# (e.g. a local Postgres URL in dev vs. a Neon URL in production, or test
# vs. live Stripe keys). There is currently no env var that must be unset
# or dev-specific in production.
